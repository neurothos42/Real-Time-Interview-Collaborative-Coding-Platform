# Server Port (Optional, defaults to 8080 or platform-assigned PORT)
PORT=8080

# Allowed CORS & WebSocket Origins (Optional, defaults to http://localhost:5173)
# In production, supply your frontend URL (comma-separated if multiple):
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MongoDB Connection URI (Required)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/interview_platform

# JWT Secret Key (Required: minimum 256-bit / 32-character secret)
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long

# Online Compiler API (Required for Code Execution feature)
ONLINE_COMPILER_API_URL=https://judge0-ce.p.rapidapi.com
ONLINE_COMPILER_API_KEY=your_online_compiler_api_key_here

# Google Gemini API (Required for AI Mock Interviews)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=your_gemini_api_key_here

# Dataset Seeding on Startup (Optional, defaults to true)
# Set to false to bypass seeding if questions already exist in MongoDB
SEED_QUESTIONS_ENABLED=true
