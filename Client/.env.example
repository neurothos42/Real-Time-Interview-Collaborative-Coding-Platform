# Backend API Base URL (Required)
# Local development: http://localhost:8080/api
# Production: https://<your-backend-domain>/api
VITE_API_URL=http://localhost:8080/api

# Optional WebRTC ICE Servers (STUN/TURN)
# Default STUN (stun:stun.l.google.com:19302) is automatically used if unset.
# For production TURN fallback behind symmetric NATs, provide a JSON array:
# VITE_ICE_SERVERS='[{"urls":"turn:turn.example.com:3478?transport=udp","username":"user","credential":"password"}]'
